## Copia este archivo como local.properties (NO se versiona) y completa los valores.
## Android Studio agrega sdk.dir automáticamente; no lo borres.

# --- WhatsApp vía GREEN-API ---
green.apiUrl=https://api.green-api.com
green.idInstance=1234567890
green.apiToken=TU_TOKEN
# Destino por defecto (lada de país, solo dígitos). Cada usuario puede vincular el suyo en Perfil.
green.chatDestino=5213312345678
