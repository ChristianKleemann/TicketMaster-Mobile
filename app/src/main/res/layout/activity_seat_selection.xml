<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tm_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAsientos"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tm_surface"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/seleccion_asientos_title" />

    <TextView
        android:id="@+id/tvEventoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tm_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        tools:text="Ballet Folclórico de México — 15 oct 2026, 19:30"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/tvLimiteAsientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/limite_asientos_aviso"
        android:textColor="@color/tm_text_secondary"
        android:textSize="13sp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp" />

    <!-- Tipo de servicio (tipo de asiento) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupServicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvServicioDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:textColor="@color/tm_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:textColor="@color/tm_white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Leyenda de colores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_seat_disponible" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leyenda_disponible"
            android:textColor="@color/tm_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_seat_seleccionado" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leyenda_seleccionado"
            android:textColor="@color/tm_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_seat_ocupado" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leyenda_ocupado"
            android:textColor="@color/tm_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAsientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp" />

    <!-- Barra inferior: total + botón continuar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/tm_surface"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tm_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Total: $900.00"
            xmlns:tools="http://schemas.android.com/tools" />

        <Button
            android:id="@+id/btnContinuarPago"
            style="@style/Widget.TicketMaster.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/btn_continuar_pago" />

    </LinearLayout>

</LinearLayout>
