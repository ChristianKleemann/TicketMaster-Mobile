<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/tm_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEstablecimientoTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tm_blue_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            tools:text="TEATRO" />

        <TextView
            android:id="@+id/tvEstablecimientoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/tm_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Teatro Degollado" />

        <TextView
            android:id="@+id/tvEstablecimientoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tm_text_secondary"
            android:textSize="14sp"
            tools:text="Belén 6, Guadalajara" />

        <TextView
            android:id="@+id/tvEstablecimientoHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/tm_text_primary"
            android:textSize="13sp"
            tools:text="Servicio: Martes a Domingo · 10:00–23:00" />

        <TextView
            android:id="@+id/tvEstablecimientoCapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tm_text_secondary"
            android:textSize="13sp"
            tools:text="Capacidad: 2,487 lugares · Máx. 10 boletos por usuario" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
