<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tm_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pago_exitoso_title"
                android:textColor="@color/tm_success"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfOrden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/tm_text_secondary"
                android:textSize="13sp"
                tools:text="Orden #12 · Ref. TM-AB12CD34" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvConfEvento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="La Traviata" />

                    <TextView
                        android:id="@+id/tvConfLugar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tm_text_secondary"
                        android:textSize="14sp"
                        tools:text="Teatro Colón" />

                    <TextView
                        android:id="@+id/tvConfFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Fecha y hora: mié 7 oct 2026, 20:00 hrs" />

                    <TextView
                        android:id="@+id/tvConfCantidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="15sp"
                        tools:text="Cantidad de boletos: 3" />

                    <TextView
                        android:id="@+id/tvConfDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="14sp"
                        tools:text="• Palcos ×3 — $10,500.00" />

                    <TextView
                        android:id="@+id/tvConfMonto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/tm_blue_text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Monto pagado: $10,500.00" />

                    <TextView
                        android:id="@+id/tvConfMetodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/tm_text_secondary"
                        android:textSize="13sp"
                        tools:text="Tarjeta de Crédito •••• 1234" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Estado del envío del ticket por WhatsApp -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConfWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvConfWhatsappEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="✅ Ticket enviado a tu WhatsApp" />

                    <TextView
                        android:id="@+id/tvConfWhatsappDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tm_text_secondary"
                        android:textSize="13sp"
                        tools:text="Revisa tu chat" />

                    <Button
                        android:id="@+id/btnConfWhatsappAccion"
                        style="@style/Widget.TicketMaster.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        tools:text="Reintentar ahora" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información de acceso"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConfAcceso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnConfPerfil"
        style="@style/Widget.TicketMaster.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Ver mis boletos" />
</LinearLayout>
