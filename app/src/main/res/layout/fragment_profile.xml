<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tm_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_de_usuario"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/tm_text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Tarjeta de datos personales -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvProfileNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/tm_text_primary"
                        tools:text="Juan Pérez García" />

                    <TextView
                        android:id="@+id/tvProfileCurp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textColor="@color/tm_text_secondary"
                        tools:text="CURP: PEGJ900101HJCRZN01" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/tm_outline" />

                    <TextView
                        android:id="@+id/tvProfileEdad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/tm_text_primary"
                        android:layout_marginBottom="6dp"
                        tools:text="Edad: 35 años" />

                    <TextView
                        android:id="@+id/tvProfileSexo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/tm_text_primary"
                        android:layout_marginBottom="6dp"
                        tools:text="Sexo: Masculino" />

                    <TextView
                        android:id="@+id/tvProfileEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/tm_text_primary"
                        android:layout_marginBottom="6dp"
                        tools:text="Estado: Jalisco" />

                    <TextView
                        android:id="@+id/tvProfileFechaRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/tm_text_secondary"
                        tools:text="Cuenta creada el 2026-10-04" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de WhatsApp -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/whatsapp_titulo"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/tm_text_secondary"
                        android:textSize="14sp"
                        tools:text="Número vinculado: +52 1 33 2218 0006" />

                    <Button
                        android:id="@+id/btnVincularWhatsapp"
                        style="@style/Widget.TicketMaster.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/whatsapp_vincular" />

                    <Button
                        android:id="@+id/btnProbarWhatsapp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/whatsapp_probar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.TicketMaster.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cerrar_sesión" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_boletos_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/tm_text_primary"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSinCompras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_compras"
                android:textColor="@color/tm_text_secondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorialOrdenes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_orden_historial" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
