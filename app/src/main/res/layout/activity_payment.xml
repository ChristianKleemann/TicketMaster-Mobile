<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tm_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPago"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tm_surface"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/pago_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Resumen de la compra -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tm_card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResumenEvento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Ballet Folclórico de México" />

                    <TextView
                        android:id="@+id/tvResumenFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/tm_text_secondary"
                        android:textSize="13sp"
                        tools:text="15 oct 2026, 19:30 hrs" />

                    <TextView
                        android:id="@+id/tvResumenAsientos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="14sp"
                        tools:text="Asientos: A1, A2, A3" />

                    <TextView
                        android:id="@+id/tvResumenCantidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/tm_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Cantidad de boletos: 3" />

                    <TextView
                        android:id="@+id/tvResumenTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/tm_blue"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Monto a pagar: $900.00" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pago_title"
                android:textColor="@color/tm_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgMetodosPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Formulario de tarjeta (crédito / débito) -->
            <LinearLayout
                android:id="@+id/llFormTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNumeroTarjeta"
                    style="@style/Widget.TicketMaster.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de tarjeta (16 dígitos)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNumeroTarjeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:maxLength="16"
                        android:textColor="@color/tm_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombreTarjeta"
                    style="@style/Widget.TicketMaster.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nombre del titular (solo texto)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreTarjeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50"
                        android:textColor="@color/tm_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVencimiento"
                        style="@style/Widget.TicketMaster.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="Vence (MM/AA)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVencimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789/"
                            android:inputType="number"
                            android:maxLength="5"
                            android:textColor="@color/tm_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCvv"
                        style="@style/Widget.TicketMaster.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="CVV">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:inputType="numberPassword"
                            android:maxLength="3"
                            android:textColor="@color/tm_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Formulario PayPal -->
            <LinearLayout
                android:id="@+id/llFormPaypal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreoPaypal"
                    style="@style/Widget.TicketMaster.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Correo de tu cuenta PayPal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreoPaypal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/tm_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombrePaypal"
                    style="@style/Widget.TicketMaster.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nombre del titular (solo texto)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombrePaypal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50"
                        android:textColor="@color/tm_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Simulación: no se procesa un pago real. Solo se guardan los últimos 4 dígitos de la tarjeta; el número completo y el CVV nunca se almacenan."
                android:textColor="@color/tm_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnConfirmarPago"
        style="@style/Widget.TicketMaster.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/btn_confirmar_pago" />

</LinearLayout>
