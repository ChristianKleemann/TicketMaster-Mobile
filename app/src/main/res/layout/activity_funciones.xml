<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tm_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarFunciones"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/tm_surface"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/funciones_title" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/tm_card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNombreEstablecimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Teatro Colón" />

            <TextView
                android:id="@+id/tvInfoHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tm_text_primary"
                android:textSize="13sp"
                tools:text="Servicio: Martes a Domingo · 10:00–23:00" />

            <TextView
                android:id="@+id/tvInfoCapacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/tm_text_secondary"
                android:textSize="13sp"
                tools:text="Capacidad: 2,487 lugares · Máx. 10 boletos por usuario" />

            <TextView
                android:id="@+id/tvAvisoDiaNoLaboral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tm_error"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Hoy no hay venta de boletos: ..."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvToggleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="Ver reglas de acceso y días festivos ▾"
                android:textColor="@color/tm_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llInfoExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvInfoVestimenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/tm_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvInfoRestricciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/tm_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvInfoFestivos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/tm_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFechas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvSinFunciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sin_funciones"
        android:textColor="@color/tm_text_secondary"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFunciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp" />

</LinearLayout>
