<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/tm_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvZonaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Palcos" />

            <TextView
                android:id="@+id/tvZonaDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_secondary"
                android:textSize="13sp"
                tools:text="Palcos laterales con la mejor visibilidad" />

            <TextView
                android:id="@+id/tvZonaPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/tm_blue_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$3,500.00" />

            <TextView
                android:id="@+id/tvZonaDisponibles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_secondary"
                android:textSize="12sp"
                tools:text="Disponibles: 487 de 487" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMenos"
            style="@style/Widget.TicketMaster.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−" />

        <TextView
            android:id="@+id/tvCantidad"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/tm_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMas"
            style="@style/Widget.TicketMaster.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
